# must not be published. See README.md's "Documentation" section.
docs/

# Signing keys and secrets — never commit these
*.keystore
*.jks
*.p12
*.pem
*.key
keystore.properties
key.properties
service-account*.json
.env
.env.*
!.env.example

# Local SQLite databases (a copied-out pos.db holds real client data)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Python bytecode (scripts/)
__pycache__/
*.pyc
